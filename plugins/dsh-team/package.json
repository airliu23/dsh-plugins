{
  "name": "@local/dsh-team",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Background tickets: parallel Headless workers driven from any Session",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./store": "./store.js",
    "./runner": "./runner.js",
    "./dispatcher": "./dispatcher.js"
  },
  "files": [
    "index.js",
    "store.js",
    "runner.js",
    "dispatcher.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
